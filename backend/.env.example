PORT=5000
NODE_ENV=development

# Local Postgres (pgAdmin) — used by `npm run dev`
DATABASE_URL=postgresql://postgres:root@127.0.0.1:5432/digital-menu
DIRECT_URL=postgresql://postgres:root@127.0.0.1:5432/digital-menu
TEST_DATABASE_URL=postgresql://postgres:root@127.0.0.1:5432/scan_test

# Production = Neon on Vercel (Project → Settings → Environment Variables).
# Do not put Neon URLs in DATABASE_URL here.
# Optional on the laptop only: inspect prod usage from local superadmin.
# PRODUCTION_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=change-me-min-16-chars
JWT_EXPIRES_IN=7d

# One-shot superadmin bootstrap (npm run db:superadmin)
# Local: set in backend/.env or pass CLI args.
# Prod: run once from your machine with prod DATABASE_URL / DIRECT_URL (Vercel → Production).
# Do not store SUPERADMIN_PASSWORD in Vercel permanently.
# SUPERADMIN_EMAIL=you@example.com
# SUPERADMIN_PASSWORD=change-me-now
# SUPERADMIN_NAME=Adnane EL MENOUAR

CLIENT_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000
ROOT_DOMAIN=scanosh.com

# OCR
OCR_SERVICE_URL=
OCR_SERVICE_TOKEN=

# NVIDIA (clé commune si les clés dédiées sont vides)
NVIDIA_API_KEY=

# LLM TEXTE — structure le menu (OCR → JSON)
MENU_LLM_MODEL=openai/gpt-oss-20b
MENU_LLM_FALLBACK_MODELS=google/gemma-4-31b-it
MENU_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
MENU_LLM_TIMEOUT_MS=90000
# MENU_LLM_API_KEY=

# LLM IMAGE — génère les photos produits
NVIDIA_FLUX_ENABLED=1
NVIDIA_FLUX_MODEL=black-forest-labs/flux.2-klein-4b
NVIDIA_FLUX_BASE_URL=https://ai.api.nvidia.com/v1/genai
NVIDIA_FLUX_TIMEOUT_MS=45000
# NVIDIA_FLUX_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — Resend (recommandé en prod)
# 1. https://resend.com → API Keys → créer une clé
# 2. Domains → ajouter scanosh.com → copier les enregistrements DNS dans Cloudflare
# 3. Une fois le domaine vérifié, utiliser contact@scanosh.com comme expéditeur
RESEND_API_KEY=
MAIL_FROM=Scanosh <contact@scanosh.com> (ignoré si RESEND_API_KEY est défini)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
