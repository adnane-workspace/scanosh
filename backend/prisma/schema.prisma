generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  superadmin
}

enum ActivityAction {
  cafe_created
  cafe_activated
  cafe_deactivated
  cafe_deleted
  cafe_password_reset
  cafe_email_updated
  cafe_updated
  auth_login
  auth_login_failed
  auth_password_changed
  product_created
  product_updated
  product_deleted
  product_availability
  category_created
  category_updated
  category_deleted
  qr_generated
  qr_change_requested
  qr_change_approved
  qr_change_rejected
  trial_started
  trial_reset
}

enum QrChangeRequestStatus {
  pending
  approved
  rejected
}

enum VerificationPurpose {
  password_reset
  email_verify
}

enum CafeTrialRole {
  none
  playground
  template
}

enum MenuImportStatus {
  pending
  reviewed
  published
  failed
}

model Cafe {
  id          String        @id @default(uuid())
  name        String        @db.VarChar(120)
  description String        @default("") @db.VarChar(500)
  logo              String        @default("")
  cover             String        @default("")
  address           String        @default("") @db.VarChar(200)
  phone       String        @default("") @db.VarChar(30)
  latitude    Float?
  longitude   Float?
  slug            String        @unique @db.VarChar(80)
  menuUi          Json          @default("{}")
  isActive        Boolean       @default(true)
  qrGeneratedAt   DateTime?
  qrChangeAllowed Boolean       @default(false)
  trialRole       CafeTrialRole @default(none)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  users           User[]
  categories      Category[]
  products        Product[]
  activityLogs    ActivityLog[]
  qrChangeRequests QrChangeRequest[]
  menuImports     MenuImport[]

  @@index([trialRole])
}

model MenuImport {
  id             String           @id @default(uuid())
  cafeId         String
  cafe           Cafe             @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  status         MenuImportStatus @default(pending)
  sourceImageUrl String           @default("")
  mergeLevel     String           @default("paragraph") @db.VarChar(20)
  rawText        String           @default("") @db.Text
  rawBlocks      Json             @default("[]")
  draftMenu      Json?
  provider       String           @default("") @db.VarChar(80)
  errorMessage   String           @default("") @db.VarChar(500)
  durationMs     Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([cafeId, createdAt])
  @@index([cafeId, status])
}

model User {
  id               String          @id @default(uuid())
  name             String          @db.VarChar(80)
  email            String          @unique @db.VarChar(160)
  passwordHash     String
  role             UserRole        @default(admin)
  cafeId           String?
  cafe             Cafe?           @relation(fields: [cafeId], references: [id], onDelete: SetNull)
  emailVerifiedAt  DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  activityLogs     ActivityLog[]
  passwordResets   PasswordReset[]
  qrChangeRequests QrChangeRequest[] @relation("QrChangeRequester")
  qrChangeReviews  QrChangeRequest[] @relation("QrChangeReviewer")

  @@index([cafeId])
}

model TrialLead {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(80)
  email     String   @db.VarChar(160)
  phone     String   @db.VarChar(30)
  cafeName  String   @db.VarChar(120)
  city      String   @default("") @db.VarChar(80)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model QrChangeRequest {
  id          String                 @id @default(uuid())
  cafeId      String
  cafe        Cafe                   @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User                   @relation("QrChangeRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  reason      String                 @db.VarChar(400)
  status      QrChangeRequestStatus  @default(pending)
  reviewerId  String?
  reviewer    User?                  @relation("QrChangeReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote  String                 @default("") @db.VarChar(400)
  reviewedAt  DateTime?
  createdAt   DateTime               @default(now())

  @@index([cafeId, status])
  @@index([status, createdAt])
}

model PasswordReset {
  id         String               @id @default(uuid())
  email      String               @db.VarChar(160)
  userId     String?
  user       User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    VerificationPurpose  @default(password_reset)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                  @default(0)
  createdAt  DateTime             @default(now())

  @@index([email, createdAt])
  @@index([email, purpose, createdAt])
}

model ActivityLog {
  id        String         @id @default(uuid())
  action    ActivityAction
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  cafeId    String?
  cafe      Cafe?    @relation(fields: [cafeId], references: [id], onDelete: SetNull)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([cafeId])
}

model Category {
  id          String     @id @default(uuid())
  cafeId      String
  cafe        Cafe       @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  name        String     @db.VarChar(80)
  description String     @default("") @db.VarChar(300)
  image       String     @default("")
  order       Int      @default(0)
  sectionKey  String?  @db.VarChar(40)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    Product[]

  @@unique([cafeId, sectionKey])
  @@index([cafeId, order])
  @@index([cafeId, parentId, order])
}

model Product {
  id          String   @id @default(uuid())
  cafeId      String
  cafe        Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(120)
  description String   @default("") @db.VarChar(500)
  price       Decimal  @db.Decimal(10, 2)
  image       String   @default("")
  available   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([cafeId, categoryId, order])
}
