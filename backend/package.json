{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "node scripts/prisma.mjs generate && node scripts/prisma.mjs migrate",
    "vercel-build": "node scripts/prisma.mjs generate && node scripts/prisma.mjs migrate",
    "cloudinary:purge": "node scripts/purge-cloudinary.mjs",
    "db:clear-images": "node scripts/clear-db-cloudinary-urls.mjs",
    "mail:test": "node scripts/test-mail.mjs",
    "menu-llm:test": "node scripts/test-menu-llm.mjs",
    "postinstall": "node scripts/prisma.mjs generate",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:migrate": "node scripts/prisma.mjs migrate",
    "db:superadmin": "node scripts/create-superadmin.mjs",
    "db:push": "npx prisma db push",
    "lint": "eslint src",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --runInBand --selectProjects unit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "nodemailer": "^7.0.11",
    "prisma": "^6.19.3",
    "zod": "^4.0.17"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "bcrypt@6.0.0": true
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "jest": "^30.0.5"
  }
}
